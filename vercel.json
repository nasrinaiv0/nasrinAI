{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/v1/internal/retention",
      "schedule": "0 * * * *"
    },
    {
      "path": "/v1/internal/web-crawl",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 120
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ncc.nasrinai.com"
        }
      ],
      "destination": "/ncc/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "studio.nasrinai.com"
        }
      ],
      "destination": "https://nasrinai.com/video-studio.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/chat/:code",
      "destination": "/chat.html"
    },
    {
      "source": "/v1",
      "destination": "/api/index?__path=/v1"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/index?__path=/v1/:path*"
    },
    {
      "source": "/healthz",
      "destination": "/api/index?__path=/healthz"
    }
  ],
  "headers": [
    {
      "source": "/((?!v1(?:/|$)|healthz$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob: https://i.ytimg.com https://upload.wikimedia.org; connect-¶»§q«^